#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: verify-hub-drive-check-skill-live <skill-name>" >&2
  exit 2
fi
SKILL_NAME="$1"

if ! [[ "${SKILL_NAME}" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "verify-hub drive check-skill-live: FAIL — invalid skill name: ${SKILL_NAME}" >&2
  exit 2
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

VERIFY_HUB_RUN_ID="${VERIFY_HUB_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
VERIFY_HUB_ARTIFACTS_DIR="${VERIFY_HUB_ARTIFACTS_DIR:-/opt/cursor/artifacts/verify-hub/${VERIFY_HUB_RUN_ID}}"
mkdir -p "${VERIFY_HUB_ARTIFACTS_DIR}"

TRANSCRIPT="${VERIFY_HUB_ARTIFACTS_DIR}/check-skill-live-${SKILL_NAME}.transcript"
set +e
python3 scripts/check_skill_live.py "${SKILL_NAME}" >"${TRANSCRIPT}" 2>&1
EXIT=$?
set -e

if [[ "${EXIT}" -ne 0 ]]; then
  echo "verify-hub drive check-skill-live: FAIL skill=${SKILL_NAME} exit=${EXIT}"
  cat "${TRANSCRIPT}"
  exit "${EXIT}"
fi

if ! grep -q "live-eligible" "${TRANSCRIPT}"; then
  echo "verify-hub drive check-skill-live: FAIL — expected live-eligible message"
  cat "${TRANSCRIPT}"
  exit 1
fi

echo "verify-hub drive check-skill-live: OK skill=${SKILL_NAME} (transcript=${TRANSCRIPT})"
